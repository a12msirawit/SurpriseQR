# =============================================================================
# SurpriseQR — Environment Variables (Vercel Deployment Template)
# =============================================================================
# Copy this file to .env.local for local development, or set these in the
# Vercel Dashboard → Project → Settings → Environment Variables for production.
#
# ⚠️  NEVER commit real secret values. Only this template should be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (REQUIRED)
# -----------------------------------------------------------------------------
# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key — SERVER-ONLY, never expose to the client.
# Used behind requireAdmin() for privileged writes (credits, profile mutations,
# admin audit logs, ban/moderation, payment approval).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Cron Job Protection (REQUIRED for production)
# -----------------------------------------------------------------------------
# Protects the /api/cron/* routes (Bearer secret). If unset, cron jobs are
# disabled (they return 401). Set a long random string (≥32 chars) and schedule
# the jobs with it via Vercel Cron or GitHub Actions.
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# -----------------------------------------------------------------------------
# PromptPay (REQUIRED for payments)
# -----------------------------------------------------------------------------
# Public PromptPay ID used to render the transfer QR / slip target.
# Example: 0980013003 (phone) or 1234567890123 (national ID)
NEXT_PUBLIC_PROMPTPAY_ID=your-promptpay-id-here

# -----------------------------------------------------------------------------
# Optional / Auto-set by platform
# -----------------------------------------------------------------------------
# NODE_ENV is set automatically by Next.js / Vercel (development | production).
# Do NOT set manually unless running custom builds.
# NODE_ENV=production
